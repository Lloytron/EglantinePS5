+bool RasterizerVulkan::EmulatesNativeTensorPrograms() const {
+    // Mesa's Intel driver takes minutes to compile an emulated network (Ocarina of Time's has 768
+    // matrix multiplies) and then runs it at about 8 FPS. The upscale stand-in draws instead.
+    // PS5 port: on the console's RADV the emulated network stalls the GPU until the game gives up
+    // (2010-0212 after 30 s on Ocarina's title video), so it gets the stand-in too.
+    const auto driver = device.GetDriverID();
+    return driver != VK_DRIVER_ID_INTEL_OPEN_SOURCE_MESA && driver != VK_DRIVER_ID_MESA_RADV;
+}
