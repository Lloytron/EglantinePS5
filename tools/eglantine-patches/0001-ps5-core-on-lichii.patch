diff --git a/src/video_core/readback_dependency_diagnostics.h b/src/video_core/readback_dependency_diagnostics.h
new file mode 100644
index 00000000..2e485f0c
--- /dev/null
+++ b/src/video_core/readback_dependency_diagnostics.h
@@ -0,0 +1,217 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <optional>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/rasterizer_download_area.h"
+
+namespace VideoCommon::ReadbackDependencyDiagnostics {
+
+inline u64 Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+struct Window {
+    static constexpr u64 Delay = 60'000'000'000;
+    static constexpr u64 Duration = 30'000'000'000;
+    static constexpr u64 Limit = 4096;
+    std::atomic<u64> next_slot{};
+
+    bool Select(u64 elapsed) {
+        if (elapsed < Delay) {
+            return false;
+        }
+        if (elapsed - Delay >= Duration) {
+            next_slot.store(Limit, std::memory_order_relaxed);
+            return false;
+        }
+        const u64 slot = (elapsed - Delay) * Limit / Duration;
+        u64 next = next_slot.load(std::memory_order_relaxed);
+        while (next <= slot) {
+            if (next_slot.compare_exchange_weak(next, slot + 1, std::memory_order_relaxed)) {
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+struct Record {
+    u64 core{}, address{}, size{}, fence{}, published_sequence{};
+    u64 requested_generation{}, backend_generation{}, checked_generation{}, checked_sequence{};
+    u64 return_generation{}, before_lock{}, enqueued{}, front_popped{}, backend_start{};
+    u64 area_end{}, flush_end{}, cpu_return{};
+    u32 docked_mode{}, gpu_accuracy{}, runtime_gpu_accuracy{}, dma_accuracy{}, cpu_accuracy{};
+    bool preemptive_flag{}, split{};
+    // Complete per-read frame capture is a separate opt-in from the sampled logger.
+    u64 trace_index{~u64{0}}, request_ns{}, start_frame{}, end_frame{};
+    u64 original_address{}, original_size{}, caller{}, dirty_mask{};
+    u64 wait_begin{}, wait_end{}, completed_fence_at_request{}, pending_channels{};
+    u64 scalar_valid{}, value_before{}, value_after{}, pending_before_valid{}, pending_before{};
+    u64 pending_backend_valid{}, pending_backend{};
+    u64 guest_pc{}, guest_lr{}, guest_sp{}, guest_x0{}, guest_x1{}, guest_x2{}, guest_x3{};
+    u64 guest_x19{}, guest_x20{}, guest_x21{}, guest_x22{}, guest_x23{}, guest_x24{};
+    u64 buffer_gpu_copy_bytes{}, buffer_cpu_copy_bytes{};
+    u64 gpu_wait_ns{}, gpu_wait_count{}, gpu_wait_tick_max{};
+};
+
+// GPU-owner context: scopes nested backend work to this ordered read only.
+inline thread_local Record* backend_record{};
+class BackendScope {
+public:
+    explicit BackendScope(Record* record) : previous{backend_record} {
+        backend_record = record && record->trace_index != ~u64{0} ? record : nullptr;
+    }
+    ~BackendScope() { backend_record = previous; }
+private:
+    Record* previous;
+};
+extern "C" void eden_buffer_readback_copy_bytes(u64, u64) __attribute__((weak));
+inline void BufferCopyBytes(u64 gpu_bytes, u64 cpu_bytes) {
+    if (eden_buffer_readback_copy_bytes) eden_buffer_readback_copy_bytes(gpu_bytes, cpu_bytes);
+    if (backend_record) {
+        backend_record->buffer_gpu_copy_bytes += gpu_bytes;
+        backend_record->buffer_cpu_copy_bytes += cpu_bytes;
+    }
+}
+extern "C" void eden_buffer_readback_source(u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64)
+    __attribute__((weak));
+template <class Runtime, class Buffer>
+inline void BufferCopySource(Runtime& runtime, const Buffer& buffer, u64 offset, u64 bytes, bool asynchronous) {
+    if constexpr (requires { buffer.IsSparseCompatible(); buffer.Location().memory_type; runtime.CurrentTick(); }) {
+        u64 identity = 0, producer = 0, version = 0, completed = 0;
+        if constexpr (requires { buffer.ReadbackProducer(offset, bytes); buffer.ReadbackIdentity(); }) {
+            if (const auto ticket = buffer.ReadbackProducer(offset, bytes)) {
+                producer = ticket->producer;
+                version = ticket->version;
+                if constexpr (requires { runtime.IsFree(producer); }) completed = runtime.IsFree(producer);
+            }
+            identity = buffer.ReadbackIdentity();
+        }
+        if (eden_buffer_readback_source)
+            eden_buffer_readback_source(buffer.CpuAddr(), buffer.SizeBytes(), offset, bytes,
+                buffer.IsSparseCompatible(), buffer.Location().memory_type, asynchronous, runtime.CurrentTick(), identity, producer, version, completed);
+    }
+}
+
+class GpuWaitScope {
+public:
+    explicit GpuWaitScope(u64 tick) : record{backend_record}, started{record ? Now() : 0} {
+        if (record) {
+            ++record->gpu_wait_count;
+            if (tick > record->gpu_wait_tick_max) record->gpu_wait_tick_max = tick;
+        }
+    }
+    ~GpuWaitScope() { if (record) record->gpu_wait_ns += Now() - started; }
+private:
+    Record* record;
+    u64 started;
+};
+
+struct GuestContextProvider {
+    void* object{};
+    void (*capture)(void*, Record&){};
+};
+inline thread_local GuestContextProvider guest_context_provider;
+class GuestContextScope {
+public:
+    GuestContextScope(void* object, void (*capture)(void*, Record&))
+        : previous{guest_context_provider} { guest_context_provider = {object, capture}; }
+    ~GuestContextScope() { guest_context_provider = previous; }
+private:
+    GuestContextProvider previous;
+};
+
+struct CallerContext { u64 kind{}, address{}, size{}; const void* pointer{}; };
+inline thread_local CallerContext caller_context;
+class CallerScope {
+public:
+    CallerScope(u64 kind, u64 address, u64 size, const void* pointer = nullptr) : previous{caller_context} {
+        caller_context = {kind, address, size, pointer};
+    }
+    ~CallerScope() { caller_context = previous; }
+private:
+    CallerContext previous;
+};
+
+extern "C" bool eden_ordered_read_trace_begin(Record*) __attribute__((weak));
+extern "C" void eden_ordered_read_trace_end(const Record*,
+    const VideoCore::RasterizerDownloadArea*) __attribute__((weak));
+
+// Observational snapshots only: they neither satisfy a guest load nor certify coherence.
+inline u64 ScalarSnapshot(const CallerContext& context) {
+    u64 value{};
+    if (context.pointer && (context.size == 1 || context.size == 2 ||
+                            context.size == 4 || context.size == 8))
+        std::memcpy(&value, context.pointer, context.size);
+    return value;
+}
+
+inline std::optional<Record> Begin() {
+    Record trace;
+    if (eden_ordered_read_trace_begin && eden_ordered_read_trace_begin(&trace)) {
+        trace.caller = caller_context.kind;
+        trace.original_address = caller_context.address;
+        trace.original_size = caller_context.size;
+        trace.scalar_valid = caller_context.kind == 4 && caller_context.pointer &&
+            (caller_context.size == 1 || caller_context.size == 2 ||
+             caller_context.size == 4 || caller_context.size == 8) &&
+            (caller_context.address & 4095) + caller_context.size <= 4096;
+        if (trace.scalar_valid) trace.value_before = ScalarSnapshot(caller_context);
+        if (trace.scalar_valid && trace.original_size == 4 && guest_context_provider.capture)
+            guest_context_provider.capture(guest_context_provider.object, trace);
+        return trace;
+    }
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_READBACK_DEPENDENCY_DIAGNOSTICS");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled) {
+        return std::nullopt;
+    }
+    static const u64 origin = Now();
+    static Window window;
+    thread_local u64 requests{};
+    if ((requests++ & 63) != 0) {
+        return std::nullopt;
+    }
+    if (window.next_slot.load(std::memory_order_relaxed) == Window::Limit ||
+        !window.Select(Now() - origin)) {
+        return std::nullopt;
+    }
+    return Record{};
+}
+
+inline void Report(const Record& record, const VideoCore::RasterizerDownloadArea& result) {
+    if (record.trace_index != ~u64{0}) {
+        if (eden_ordered_read_trace_end) eden_ordered_read_trace_end(&record, &result);
+        return; // Buffer binary records; never format/log each hot-path read.
+    }
+    LOG_INFO(HW_GPU,
+             "ReadbackDependency core={} addr={:#x} size={} fence={} sequence={} split={} "
+             "requested_generation={} backend_generation={} checked_generation={} "
+             "checked_sequence={} return_generation={} "
+             "result_begin={:#x} result_end={:#x} preemptive_flag={} "
+             "before_lock_ns={} enqueued_ns={} front_popped_ns={} backend_start_ns={} "
+             "area_end_ns={} flush_end_ns={} cpu_return_ns={} docked_mode={} gpu_accuracy={} "
+             "runtime_gpu_accuracy={} dma_accuracy={} cpu_accuracy={}",
+             record.core, record.address, record.size, record.fence, record.published_sequence,
+             record.split, record.requested_generation, record.backend_generation,
+             record.checked_generation, record.checked_sequence, record.return_generation,
+             result.start_address, result.end_address,
+             record.preemptive_flag, record.before_lock, record.enqueued, record.front_popped,
+             record.backend_start, record.area_end, record.flush_end, record.cpu_return,
+             record.docked_mode, record.gpu_accuracy, record.runtime_gpu_accuracy,
+             record.dma_accuracy, record.cpu_accuracy);
+}
+
+} // namespace VideoCommon::ReadbackDependencyDiagnostics
diff --git a/src/video_core/readback_diagnostics.h b/src/video_core/readback_diagnostics.h
new file mode 100644
index 00000000..9e0ef9a5
--- /dev/null
+++ b/src/video_core/readback_diagnostics.h
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCommon::ReadbackDiagnostics {
+
+enum class Event : size_t {
+    OrderedRead,
+    FlushArea,
+    TextureReadback,
+    BufferReadback,
+    QueryReadback,
+    DownloadStaging,
+    DeferredDownloadStaging,
+    UploadStaging,
+    BufferFinish,
+    Submit,
+    DeviceFinish,
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Event::Count)> names{
+    "ordered_read", "flush_area", "texture_readback", "buffer_readback", "query_readback",
+    "download_staging", "deferred_download_staging", "upload_staging", "buffer_finish",
+    "submit", "device_finish",
+};
+
+inline bool Enabled() {
+    static const bool enabled = std::getenv("EDEN_NX2_READBACK_DIAGNOSTICS") != nullptr;
+    return enabled;
+}
+
+struct Measurement {
+    u64 calls{};
+    u64 bytes{};
+    u64 samples{};
+    u64 sampled_ns{};
+};
+
+struct ThreadData {
+    std::array<Measurement, static_cast<size_t>(Event::Count)> events{};
+    // Actual submission requirements: bit 0 texture, bit 1 buffer, bit 2 query.
+    std::array<u64, 8> fence_masks{};
+    u64 skipped_empty_fences{};
+    std::chrono::steady_clock::time_point begin{};
+    size_t depth{};
+    bool report_due{};
+};
+
+inline thread_local ThreadData data;
+
+inline void CountFence(u8 required, bool skipped = false) {
+    if (!Enabled()) return;
+    if (skipped) ++data.skipped_empty_fences;
+    else ++data.fence_masks[required & 7];
+}
+
+class Scope {
+public:
+    explicit Scope(Event event_, u64 bytes = 0) : event{event_}, enabled{Enabled()} {
+        if (!enabled) {
+            return;
+        }
+        ++data.depth;
+        auto& measurement = data.events[static_cast<size_t>(event)];
+        measurement.bytes += bytes;
+        sampled = (measurement.calls++ & 255) == 0;
+        if (sampled) {
+            start = std::chrono::steady_clock::now();
+            if (data.begin == std::chrono::steady_clock::time_point{}) {
+                data.begin = start;
+            }
+        }
+    }
+
+    ~Scope() {
+        if (!enabled) {
+            return;
+        }
+        if (sampled) {
+            const auto now = std::chrono::steady_clock::now();
+            auto& measurement = data.events[static_cast<size_t>(event)];
+            ++measurement.samples;
+            measurement.sampled_ns +=
+                std::chrono::duration_cast<std::chrono::nanoseconds>(now - start).count();
+            data.report_due |= now - data.begin >= std::chrono::seconds{10};
+        }
+        if (--data.depth != 0 || !data.report_due) {
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        std::string summary;
+        for (size_t i = 0; i < data.events.size(); ++i) {
+            const auto& value = data.events[i];
+            if (value.calls != 0) {
+                summary += fmt::format(" | {} calls={} bytes={} samples={} sampled_ns={}", names[i],
+                                       value.calls, value.bytes, value.samples, value.sampled_ns);
+            }
+        }
+        for (size_t mask = 0; mask < data.fence_masks.size(); ++mask) {
+            if (data.fence_masks[mask]) summary += fmt::format(" | fence_mask={} count={}", mask, data.fence_masks[mask]);
+        }
+        summary += fmt::format(" | skipped_empty_fences={}", data.skipped_empty_fences);
+        LOG_INFO(HW_GPU, "ReadbackDiag window_ns={}{}",
+                 std::chrono::duration_cast<std::chrono::nanoseconds>(now - data.begin).count(),
+                 summary);
+        data = {};
+        data.begin = now;
+    }
+
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Event event;
+    bool enabled;
+    bool sampled{};
+    std::chrono::steady_clock::time_point start{};
+};
+
+} // namespace VideoCommon::ReadbackDiagnostics
diff --git a/src/video_core/readback_range_tracker.h b/src/video_core/readback_range_tracker.h
new file mode 100644
index 00000000..1d837bb9
--- /dev/null
+++ b/src/video_core/readback_range_tracker.h
@@ -0,0 +1,184 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace VideoCommon {
+
+// Single GPU-owner bookkeeping for one allocation lifetime and one submission timeline.
+// This is not a lock or a memory barrier. Callers must exclude overlapping writers while
+// validating and consuming a ticket, retain the allocation, and perform host visibility
+// barriers. Every GPU writer must be recorded at command recording, not descriptor binding.
+// Untracked writes, aliases and remaps must invalidate coverage. Allocation IDs must never
+// be reused while tickets exist. There is deliberately no implicit "initially clean" state.
+class ReadbackRangeTracker {
+public:
+    using Value = std::uint64_t;
+    struct Ticket {
+        Value allocation{}, epoch{}, offset{}, size{}, version{}, producer{};
+    };
+
+    explicit ReadbackRangeTracker(Value allocation_id, Value allocation_size,
+                                  std::size_t segment_limit = 64)
+        : allocation{allocation_id}, size{allocation_size},
+          limit{std::min<std::size_t>(segment_limit, 1024)} {
+        segments.reserve(limit + 2);
+        scratch.reserve(limit + 2);
+    }
+
+    ReadbackRangeTracker(const ReadbackRangeTracker&) = delete;
+    ReadbackRangeTracker& operator=(const ReadbackRangeTracker&) = delete;
+
+    ReadbackRangeTracker(ReadbackRangeTracker&& other) noexcept
+        : allocation{std::exchange(other.allocation, 0)}, size{other.size},
+          epoch{other.epoch}, version{other.version}, last_producer{other.last_producer},
+          limit{other.limit}, segments{std::move(other.segments)},
+          scratch{std::move(other.scratch)} {}
+
+    ReadbackRangeTracker& operator=(ReadbackRangeTracker&& other) noexcept {
+        if (this != &other) {
+            allocation = std::exchange(other.allocation, 0);
+            size = other.size;
+            epoch = other.epoch;
+            version = other.version;
+            last_producer = other.last_producer;
+            limit = other.limit;
+            segments = std::move(other.segments);
+            scratch = std::move(other.scratch);
+        }
+        return *this;
+    }
+
+    // Record the submission containing the actual writer. Zero and timeline regression
+    // are rejected. Submission completion is queried separately by the caller.
+    bool RecordGpuWrite(Value offset, Value length, Value producer) {
+        if (!ValidRange(offset, length) || producer == 0 || producer < last_producer) {
+            InvalidateAll();
+            return false;
+        }
+        last_producer = producer;
+        if (!AdvanceVersion()) {
+            return false;
+        }
+        return Replace(offset, length, producer);
+    }
+
+    void Invalidate(Value offset, Value length) {
+        if (!ValidRange(offset, length)) {
+            InvalidateAll();
+            return;
+        }
+        if (AdvanceVersion()) {
+            Replace(offset, length, 0);
+        }
+    }
+
+    void InvalidateAll() {
+        segments.clear();
+        if (epoch == std::numeric_limits<Value>::max()) {
+            allocation = 0; // Permanently fail closed on identity exhaustion.
+        } else {
+            ++epoch;
+        }
+    }
+
+    [[nodiscard]] std::optional<Ticket> Lookup(Value offset, Value length) const {
+        if (!ValidRange(offset, length)) {
+            return std::nullopt;
+        }
+        const Value end = offset + length;
+        Value covered = offset, producer = 0, newest = 0;
+        for (const auto& segment : segments) {
+            if (segment.end <= covered) {
+                continue;
+            }
+            if (segment.begin > covered || segment.producer == 0) {
+                return std::nullopt;
+            }
+            producer = std::max(producer, segment.producer);
+            newest = std::max(newest, segment.version);
+            covered = std::min(end, segment.end);
+            if (covered == end) {
+                return Ticket{allocation, epoch, offset, length, newest, producer};
+            }
+        }
+        return std::nullopt;
+    }
+
+    [[nodiscard]] bool IsCurrent(const Ticket& ticket) const {
+        if (ticket.allocation != allocation || ticket.epoch != epoch) {
+            return false;
+        }
+        const auto current = Lookup(ticket.offset, ticket.size);
+        return current && current->version == ticket.version &&
+               current->producer == ticket.producer;
+    }
+
+    [[nodiscard]] std::size_t SegmentCount() const { return segments.size(); }
+
+private:
+    struct Segment {
+        Value begin, end, producer, version;
+    };
+
+    bool ValidRange(Value offset, Value length) const {
+        return allocation != 0 && length != 0 && offset < size && length <= size - offset;
+    }
+
+    bool AdvanceVersion() {
+        if (version == std::numeric_limits<Value>::max()) {
+            InvalidateAll();
+            allocation = 0;
+            return false;
+        }
+        ++version;
+        return true;
+    }
+
+    bool Replace(Value offset, Value length, Value producer) {
+        const Value end = offset + length;
+        // At most two extra splits; storage is reserved once, not per GPU write.
+        auto& next = scratch;
+        next.clear();
+        for (const auto& segment : segments) {
+            if (segment.end <= offset || segment.begin >= end) {
+                next.push_back(segment);
+                continue;
+            }
+            if (segment.begin < offset) {
+                next.push_back({segment.begin, offset, segment.producer, segment.version});
+            }
+            if (segment.end > end) {
+                next.push_back({end, segment.end, segment.producer, segment.version});
+            }
+        }
+        // Unknown coverage is represented by a gap, never a completion ticket.
+        if (producer != 0) {
+            next.push_back({offset, end, producer, version});
+        }
+        if (next.size() > limit) {
+            InvalidateAll(); // Bounded metadata; callers retain the staging fallback.
+            return false;
+        }
+        std::sort(next.begin(), next.end(), [](const Segment& a, const Segment& b) {
+            return a.begin < b.begin;
+        });
+        segments.swap(next);
+        return true;
+    }
+
+    Value allocation{}, size{}, epoch{1}, version{}, last_producer{};
+    std::size_t limit{};
+    std::vector<Segment> segments;
+    std::vector<Segment> scratch;
+};
+
+} // namespace VideoCommon
diff --git a/src/video_core/readback_write_tracker.h b/src/video_core/readback_write_tracker.h
new file mode 100644
index 00000000..ef7d7fc8
--- /dev/null
+++ b/src/video_core/readback_write_tracker.h
@@ -0,0 +1,131 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+#include "video_core/readback_range_tracker.h"
+
+namespace VideoCommon {
+// Diagnostic writer coverage only. Does not retain Vulkan allocations or authorize
+// mapped reads. Sparse aliases and external writers need explicit invalidation.
+template <class Handle>
+class ReadbackWriteTracker {
+public:
+    using Value = ReadbackRangeTracker::Value;
+    struct State {
+        State(Value identity_, Value size, std::shared_ptr<std::atomic<Value>> epoch_)
+            : identity{identity_}, ranges{identity_, size}, epoch{std::move(epoch_)},
+              observed_epoch{epoch->load(std::memory_order_acquire)} {}
+        void SyncEpoch() {
+            const auto current = epoch->load(std::memory_order_acquire);
+            if (observed_epoch != current) {
+                ranges.InvalidateAll();
+                observed_epoch = current;
+            }
+        }
+        Value identity;
+        ReadbackRangeTracker ranges;
+        std::shared_ptr<std::atomic<Value>> epoch;
+        Value observed_epoch;
+        std::size_t pending{};
+        bool external_writer{};
+        std::optional<ReadbackRangeTracker::Ticket> Lookup(Value offset, Value size) const {
+            const auto current = epoch->load(std::memory_order_acquire);
+            return pending || current == 0 || observed_epoch != current
+                ? std::nullopt : ranges.Lookup(offset, size);
+        }
+    };
+    explicit ReadbackWriteTracker(bool enabled = false) : enabled{enabled} {
+        if (enabled) writes.reserve(MaxWrites);
+    }
+    std::shared_ptr<State> Register(Handle handle, Value size, bool sparse) {
+        if (!enabled || sparse || size == 0 || size > 512 * 1024) return {};
+        Prune();
+        if (states.size() >= 256 || next_identity == 0) return {};
+        auto state = std::make_shared<State>(next_identity++, size, epoch);
+        states[handle] = state;
+        return state;
+    }
+    bool Enabled() const { return enabled; }
+    void InvalidateAll() {
+        // Mapping notifications may arrive outside the GPU/cache owner. They only
+        // publish an epoch; range vectors are changed by the owner on its next use.
+        Value current = epoch->load(std::memory_order_relaxed);
+        while (current != 0 && !epoch->compare_exchange_weak(
+                   current, current + 1, std::memory_order_acq_rel, std::memory_order_relaxed)) {}
+        // Zero is absorbing on epoch exhaustion, so no old identity can become valid again.
+    }
+    void Prune() {
+        std::erase_if(states, [](const auto& entry) { return entry.second.expired(); });
+    }
+    void BeginBatch() {
+        if (!enabled) return;
+        AbortBatch();
+        active = true;
+        overflow = false;
+    }
+    void NoteShaderWrite(Handle handle, Value offset, Value size) {
+        if (!enabled) return;
+        auto state = Find(handle);
+        if (!state) return;
+        state->ranges.Invalidate(offset, size);
+        if (!active) state->external_writer = true;
+        if (!active || overflow) return;
+        if (writes.size() == MaxWrites) {
+            AbortBatch();
+            overflow = true;
+            InvalidateAll();
+            enabled = false; // Coverage exhausted: never publish a partial batch.
+            return;
+        }
+        ++state->pending;
+        writes.push_back({std::move(state), offset, size});
+    }
+    // Invoke immediately after enqueueing the draw/dispatch, before any Flush.
+    void CompleteBatch(Value tick) {
+        if (!enabled) return;
+        for (auto& write : writes) {
+            write.state->SyncEpoch();
+            write.state->ranges.RecordGpuWrite(write.offset, write.size, tick);
+            --write.state->pending;
+        }
+        writes.clear();
+        active = false;
+    }
+    void AbortBatch() {
+        for (auto& write : writes) {
+            write.state->ranges.Invalidate(write.offset, write.size);
+            --write.state->pending;
+        }
+        writes.clear();
+        active = false;
+    }
+    void TransferWrite(Handle handle, Value offset, Value size, Value tick, bool reordered) {
+        if (!enabled) return;
+        if (auto state = Find(handle)) {
+            if (reordered) state->ranges.InvalidateAll();
+            else state->ranges.RecordGpuWrite(offset, size, tick);
+        }
+    }
+    void Invalidate(Handle handle) {
+        if (!enabled) return;
+        if (auto state = Find(handle)) state->ranges.InvalidateAll();
+    }
+private:
+    std::shared_ptr<State> Find(Handle handle) {
+        const auto found = states.find(handle);
+        auto state = found == states.end() ? nullptr : found->second.lock();
+        if (state) state->SyncEpoch();
+        return state;
+    }
+    struct Write { std::shared_ptr<State> state; Value offset, size; };
+    static constexpr std::size_t MaxWrites = 1024;
+    bool enabled{}, active{}, overflow{};
