+// ExecuteUnswizzlePlan reading guest memory through `read` (StreamLayerUploads: a chunk at a time).
+void ExecuteUnswizzlePlan(const UploadReader& read, const UnswizzlePlan& plan,
+                          std::span<u8> output, bool native_tiling) {
