+TEST_CASE("Sparse images require backing on every AMD driver by default", "[nx2_sparse_image]") {
+    for (const auto driver : {VK_DRIVER_ID_AMD_PROPRIETARY, VK_DRIVER_ID_AMD_OPEN_SOURCE,
+                              VK_DRIVER_ID_MESA_RADV}) {
+        CHECK_FALSE(Vulkan::CanUseUnbackedSparseImages(driver));
+        CHECK_FALSE(Vulkan::CanUseUnbackedSparseImages(driver, '0'));
+        CHECK(Vulkan::CanUseUnbackedSparseImages(driver, '1'));
+        CHECK_FALSE(Vulkan::CanUseUnbackedSparseImages(driver, 'x'));
+    }
+    CHECK(Vulkan::CanUseUnbackedSparseImages(VK_DRIVER_ID_NVIDIA_PROPRIETARY));
+    CHECK_FALSE(Vulkan::CanUseUnbackedSparseImages(VK_DRIVER_ID_NVIDIA_PROPRIETARY, '0'));
+}
+
+TEST_CASE("Sparse image data ranges clip and coalesce written blocks", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 base = 0x1000000;
+    constexpr u64 tile = Tegra::Nx2SparseMappingPageSize;
+    Tegra::Nx2SparseRegionCreated(base, 6 * tile, 2 * tile);
+    Tegra::Nx2SparseBlockWritten(base, 0);
+    Tegra::Nx2SparseBlockWritten(base, 1);
+    CHECK(Tegra::Nx2SparseDataRanges(base + tile, 5 * tile) ==
+          std::vector<std::pair<u64, u64>>{{0, 3 * tile}});
+    CHECK(Tegra::Nx2SparseDataRanges(base - 1, tile).empty());
+    CHECK(Tegra::Nx2SparseDataRanges(base, 0).empty());
+    CHECK(Tegra::Nx2SparseDataRanges(base, std::numeric_limits<u64>::max()).empty());
+    Tegra::Nx2ClearSparseRegions();
+}
+
+TEST_CASE("Sparse image tile mappings replace coarse written-block ranges", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 base = 0x1000000;
+    constexpr u64 tile = Tegra::Nx2SparseMappingPageSize;
+    Tegra::Nx2SparseRegionCreated(base, 8 * tile, 4 * tile);
+    Tegra::Nx2SparseBlockWritten(base, 0);
+    Tegra::Nx2SparseTilesMapped(base, 2 * tile, 2 * tile, true);
+    Tegra::Nx2SparseTilesMapped(base, 6 * tile, tile, true);
+    CHECK(Tegra::Nx2SparseDataRanges(base, 8 * tile) ==
+          std::vector<std::pair<u64, u64>>{{2 * tile, 2 * tile}, {6 * tile, tile}});
+    Tegra::Nx2SparseTilesMapped(base, 3 * tile, tile, false);
+    CHECK(Tegra::Nx2SparseDataRanges(base + 2 * tile + 16, 5 * tile) ==
+          std::vector<std::pair<u64, u64>>{{0, tile - 16}, {4 * tile - 16, tile}});
+    Tegra::Nx2SparseRegionDestroyed(base);
+    CHECK(Tegra::Nx2SparseDataRanges(base, tile).empty());
+}
+
+TEST_CASE("Invalid sparse tile updates cannot discard coarse residency", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 base = 0x1000000;
+    constexpr u64 tile = Tegra::Nx2SparseMappingPageSize;
+    Tegra::Nx2SparseRegionCreated(base, 4 * tile, 4 * tile);
+    Tegra::Nx2SparseBlockWritten(base, 0);
+    Tegra::Nx2SparseTilesMapped(base, 4 * tile, tile, true);
+    Tegra::Nx2SparseTilesMapped(base, 0, std::numeric_limits<u64>::max(), true);
+    CHECK(Tegra::Nx2SparseDataRanges(base, 4 * tile) ==
+          std::vector<std::pair<u64, u64>>{{0, 4 * tile}});
+    Tegra::Nx2ClearSparseRegions();
+}
+
+TEST_CASE("Sparse data range ends cannot overflow a large backing block", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 block = 1ULL << 63;
+    Tegra::Nx2SparseRegionCreated(0, std::numeric_limits<u64>::max(), block);
+    Tegra::Nx2SparseBlockWritten(0, 1);
+    CHECK(Tegra::Nx2SparseDataRanges(block, block - 1) ==
+          std::vector<std::pair<u64, u64>>{{0, block - 1}});
+    Tegra::Nx2ClearSparseRegions();
+}
+
+TEST_CASE("Sparse data ranges clip a partially mapped final tile", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 tile = Tegra::Nx2SparseMappingPageSize;
+    Tegra::Nx2SparseRegionCreated(tile, tile + 0x800, tile);
+    Tegra::Nx2SparseTilesMapped(tile, tile, 0x800, true);
+    CHECK(Tegra::Nx2SparseDataRanges(tile, tile + 0x800) ==
+          std::vector<std::pair<u64, u64>>{{tile, 0x800}});
+    Tegra::Nx2SparseTilesMapped(tile, tile, 0x800, false);
+    CHECK(Tegra::Nx2SparseDataRanges(tile, tile + 0x800).empty());
+    Tegra::Nx2ClearSparseRegions();
+}
+
+TEST_CASE("Unmapping one guest page preserves neighboring sparse coverage", "[nx2_sparse_image]") {
+    Tegra::Nx2ClearSparseRegions();
+    constexpr u64 base = 0x1000000;
+    Tegra::Nx2SparseRegionCreated(base, 0x10000, 0x10000);
+    Tegra::Nx2SparseTilesMapped(base, 0, 0x1000, true);
+    Tegra::Nx2SparseTilesMapped(base, 0x1000, 0x1000, true);
+    CHECK(Tegra::Nx2SparseDataRanges(base, 0x10000) ==
+          std::vector<std::pair<u64, u64>>{{0, 0x2000}});
+    Tegra::Nx2SparseTilesMapped(base, 0, 0x1000, false);
+    CHECK(Tegra::Nx2SparseDataRanges(base, 0x10000) ==
+          std::vector<std::pair<u64, u64>>{{0x1000, 0x1000}});
+    Tegra::Nx2ClearSparseRegions();
+}
diff --git a/src/tests/video_core/partial_download.cpp b/src/tests/video_core/partial_download.cpp
new file mode 100644
index 00000000..ad3c325a
--- /dev/null
+++ b/src/tests/video_core/partial_download.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <limits>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+#include "video_core/texture_cache/image_info.h"
+#include "video_core/texture_cache/util.h"
+#include "video_core/textures/decoders.h"
+
+namespace {
+using namespace VideoCommon;
+using VideoCore::Surface::PixelFormat;
+void CheckPartial(ImageInfo info, bool native, u64 offset, size_t size) {
+    const size_t guest_size = CalculateGuestSizeInBytes(info);
+    REQUIRE(offset + size <= guest_size);
+    std::vector<u8> initial(guest_size), linear(CalculateUnswizzledSizeBytes(info));
+    u32 random = 0x948fa513;
+    for (auto* buffer : {&initial, &linear}) for (auto& value : *buffer) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        value = static_cast<u8>(random);
+    }
+    auto whole = initial;
+    const auto bpp = VideoCore::Surface::BytesPerBlock(info.format);
+    Tegra::Texture::SwizzleTexture(whole, linear, bpp, info.size.width, info.size.height, 1,
+        info.block.height, 0, CalculateLevelStrideAlignment(info, 0), native);
+    auto expected = initial;
+    std::copy_n(whole.begin() + offset, size, expected.begin() + offset);
+    auto actual = initial;
+    const auto bands = PartialDownloadBands(info, offset, size, 4 * 1024 * 1024);
+    REQUIRE(bands.has_value());
+    size_t written{};
+    for (const auto& band : *bands) {
+        REQUIRE(band.guest_size <= 4 * 1024 * 1024);
+        REQUIRE(band.copy.buffer_size <= 4 * 1024 * 1024);
+        REQUIRE(band.guest_offset + band.guest_size <= guest_size);
+        REQUIRE(band.write_offset >= offset);
+        REQUIRE(band.write_offset + band.write_size <= offset + size);
+        REQUIRE(band.write_offset >= band.guest_offset);
+        REQUIRE(band.write_offset + band.write_size <= band.guest_offset + band.guest_size);
+        std::vector<u8> guarded(band.guest_size + 64, 0xa5);
+        const auto guest = std::span{guarded}.subspan(32, band.guest_size);
+        std::copy_n(initial.begin() + band.guest_offset, band.guest_size, guest.begin());
+        const size_t source = size_t{static_cast<u32>(band.copy.image_offset.y)} * info.size.width * bpp;
+        REQUIRE(source + band.copy.buffer_size <= linear.size());
+        SwizzleRowBand(info, band.copy, std::span{linear}.subspan(source, band.copy.buffer_size),
+                       guest, native);
+        std::copy_n(guest.begin() + band.write_offset - band.guest_offset, band.write_size,
+                    actual.begin() + band.write_offset);
+        CHECK(std::ranges::all_of(std::span{guarded}.first(32), [](u8 b) { return b == 0xa5; }));
+        CHECK(std::ranges::all_of(std::span{guarded}.last(32), [](u8 b) { return b == 0xa5; }));
+        written += band.write_size;
+    }
+    CHECK(written <= size); // Padding not occupied by image texels needs no GPU transfer.
+    CHECK(actual == expected); // Includes every untouched byte outside the request.
+}
+}
+
+TEST_CASE("Partial texture downloads match full readback only inside the requested bytes",
+          "[texture][partial_download]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {777, 193, 1};
+    info.resources = {1, 1};
+    info.format = GENERATE(PixelFormat::R8_UNORM, PixelFormat::R16_UNORM,
+                           PixelFormat::A8B8G8R8_UNORM, PixelFormat::R32G32_FLOAT);
+    info.block.height = GENERATE(0U, 2U, 4U);
+    info.tile_width_spacing = GENERATE(0U, 2U, 4U);
+    const bool native = GENERATE(false, true);
+    info.layer_stride = CalculateLayerStride(info);
+    const size_t guest_bytes = CalculateGuestSizeInBytes(info);
+    CAPTURE(info.format, info.block.height, info.tile_width_spacing, native);
+    CheckPartial(info, native, 0, 64);
+    CheckPartial(info, native, 7, 4096);
+    CheckPartial(info, native, guest_bytes / 2 - 97, 4096);
+    CheckPartial(info, native, guest_bytes - 100, 100);
+}
+
+TEST_CASE("A command read into a 64MiB image transfers a bounded GOB row",
+          "[texture][partial_download]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {4096, 4096, 1};
+    info.resources = {1, 1};
+    info.format = PixelFormat::A8B8G8R8_UNORM;
+    info.block.height = 4;
+    info.layer_stride = CalculateLayerStride(info);
+    const auto bands = PartialDownloadBands(info, 0x1234, 4096, 4 * 1024 * 1024);
+    REQUIRE(bands.has_value());
+    REQUIRE(bands->size() == 1);
+    CHECK(bands->front().copy.buffer_size == 2 * 1024 * 1024);
+    CHECK(bands->front().write_size == 4096);
+    CheckPartial(info, true, 0x1234, 4096);
+}
+
+TEST_CASE("Unsupported partial downloads preserve the full-image fallback",
+          "[texture][partial_download]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {256, 256, 1};
+    info.resources = {1, 1};
+    info.format = PixelFormat::R8_UNORM;
+    info.block.height = 2;
+    const size_t bytes = CalculateGuestSizeInBytes(info);
+    CHECK_FALSE(PartialDownloadBands(info, 0, bytes, 4 * 1024 * 1024));
+    CHECK_FALSE(PartialDownloadBands(info, 0, 0, 4 * 1024 * 1024));
+    CHECK_FALSE(PartialDownloadBands(info, bytes - 1, 2, 4 * 1024 * 1024));
+    CHECK_FALSE(PartialDownloadBands(info, std::numeric_limits<u64>::max(), 2, 4 * 1024 * 1024));
+    CHECK_FALSE(PartialDownloadBands(info, 0, 4, 1));
+    info.resources.layers = 2;
+    CHECK_FALSE(PartialDownloadBands(info, 0, 4, 4 * 1024 * 1024));
+}
diff --git a/src/tests/video_core/query_region_visit.cpp b/src/tests/video_core/query_region_visit.cpp
new file mode 100644
index 00000000..55195626
--- /dev/null
+++ b/src/tests/video_core/query_region_visit.cpp
@@ -0,0 +1,116 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <random>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include "common/container/unordered_map.h"
+#include "video_core/query_cache/region_visit.h"
+
+namespace {
+struct CountingHash {
+    static inline size_t calls{};
+    size_t operator()(u64 value) const {
+        ++calls;
+        return std::hash<u64>{}(value);
+    }
+};
+using Cache = Common::unordered_map<u64, Common::unordered_map<u32, u32>, CountingHash>;
+}
+
+TEST_CASE("Large query regions visit occupied pages without a page-by-page hash scan",
+          "[query_region]") {
+    Cache cache;
+    cache[1][0] = 1;
+    cache[1000][12] = 2;
+    cache[0x100000][28] = 3;
+    cache[0x200000][4] = 4;
+    CountingHash::calls = 0;
+    std::vector<u32> hits;
+    VideoCommon::VisitQueryRegion<12, false>(cache, 0, 6ULL << 30,
+                                           [&](u32 id) { hits.push_back(id); });
+    CHECK(hits == std::vector<u32>{1, 2, 3});
+    CHECK(CountingHash::calls == 0);
+    CHECK(cache.size() == 4);
+}
+
+TEST_CASE("Short query regions perform bounded page lookups and bool callbacks stop",
+          "[query_region]") {
+    Cache cache;
+    for (u32 page = 0; page < 1000; ++page) {
+        cache[page][16] = page;
+        cache[page][32] = page;
+    }
+    CountingHash::calls = 0;
+    size_t calls{};
+    VideoCommon::VisitQueryRegion<12, false>(cache, 123ULL << 12, 4096,
+        [&](u32 id) { CHECK(id == 123); ++calls; return true; });
+    CHECK(calls == 1);
+    CHECK(CountingHash::calls == 1);
+    calls = 0;
+    VideoCommon::VisitQueryRegion<12, false>(cache, 0, 6ULL << 30,
+        [&](u32 id) { CHECK(id == 0); ++calls; return true; });
+    CHECK(calls == 1);
+}
+
+TEST_CASE("Query visits preserve four-byte overlap and selective removal", "[query_region]") {
+    Cache cache;
+    cache[1][0] = 1;
+    cache[1][4] = 2;
+    cache[2][0] = 3;
+    std::vector<u32> hits;
+    VideoCommon::VisitQueryRegion<12, true>(cache, 4097, 1,
+                                          [&](u32 id) { hits.push_back(id); });
+    CHECK(hits == std::vector<u32>{1});
+    CHECK_FALSE(cache.at(1).contains(0));
+    CHECK(cache.at(1).at(4) == 2);
+    CHECK(cache.at(2).at(0) == 3);
+    VideoCommon::VisitQueryRegion<12, true>(cache, 4100, 4092,
+                                          [&](u32 id) { hits.push_back(id); });
+    CHECK(hits == std::vector<u32>{1, 2});
+    CHECK(cache.at(2).contains(0));
+}
+
+TEST_CASE("Query region visitor matches the page-walk reference over sparse windows",
+          "[query_region]") {
+    Cache cache;
+    for (u32 page : {0U, 1U, 3U, 14U, 38U, 111U, 500U}) {
+        for (u32 offset : {0U, 4U, 172U, 4092U}) {
+            cache[page][offset] = page * 4096 + offset;
+        }
+    }
+    std::mt19937 random(0x642a);
+    for (size_t trial = 0; trial < 1000; ++trial) {
+        const u64 start = random() % (512 * 4096);
+        const size_t size = 1 + random() % (256 * 4096);
+        const u64 end = start + size;
+        std::vector<u32> expected;
+        for (u64 page = start >> 12; page <= (end >> 12); ++page) {
+            const auto it = cache.find(page);
+            if (it == cache.end()) continue;
+            for (const auto& [offset, value] : it->second) {
+                const u64 address = page * 4096 + offset;
+                if (address < end && start < address + 4) expected.push_back(value);
+            }
+        }
+        std::vector<u32> actual;
+        VideoCommon::VisitQueryRegion<12, false>(cache, start, size,
+                                               [&](u32 id) { actual.push_back(id); });
+        std::ranges::sort(expected);
+        std::ranges::sort(actual);
+        CAPTURE(trial, start, size);
+        CHECK(actual == expected);
+    }
+}
+
+TEST_CASE("Empty and overflowing query windows do not invoke callbacks", "[query_region]") {
+    Cache cache;
+    cache[1][0] = 1;
+    unsigned calls{};
+    auto hit = [&](u32) { ++calls; };
+    VideoCommon::VisitQueryRegion<12, false>(cache, 4097, 0, hit);
+    VideoCommon::VisitQueryRegion<12, false>(cache, (std::numeric_limits<u64>::max)() - 1, 4, hit);
+    CHECK(calls == 0);
+}
