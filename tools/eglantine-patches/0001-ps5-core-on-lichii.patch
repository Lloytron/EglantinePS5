+bool PrepareSparseImageWrite(ImageFlagBits& flags, std::vector<LevelRect>& pending,
+                             Bind&& bind, Upload&& upload) {
+    if (False(flags & ImageFlagBits::SparseTiles)) {
+        return false;
+    }
+    if (!bind(pending)) {
+        throw std::bad_alloc{};
+    }
+    upload(pending);
+    pending.clear();
+    flags &= ~(ImageFlagBits::SparseTiles | ImageFlagBits::Unbacked);
+    return true;
