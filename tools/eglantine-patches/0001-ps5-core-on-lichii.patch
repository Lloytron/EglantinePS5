+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+#include "video_core/textures/decoders.h"
+
+TEST_CASE("Whole GOB copies preserve the unchanged scalar subrect layout",
+          "[texture][gob_copy]") {
+    using namespace Tegra::Texture;
+    const u32 bpp = GENERATE(1U, 2U, 4U, 8U, 16U);
+    const u32 width = GENERATE(16U, 64U, 128U, 258U);
+    const u32 height = GENERATE(1U, 9U, 65U);
+    const u32 block_height = GENERATE(0U, 4U);
+    const u32 block_depth = GENERATE(0U, 1U);
+    const bool native = GENERATE(false, true);
+    const u32 depth = block_depth ? 3 : 1;
+    CAPTURE(bpp, width, height, block_height, block_depth, native);
+    const size_t linear_bytes = size_t{width} * height * depth * bpp;
+    const size_t tiled_bytes = CalculateSize(true, bpp, width, height, depth, block_height, block_depth);
+    std::vector<u8> input(linear_bytes), expected(tiled_bytes + 64, 0xa5), tiled(tiled_bytes + 64, 0xa5);
+    u32 random = 0x3175a91d;
+    for (auto& value : input) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        value = static_cast<u8>(random);
+    }
+    SwizzleSubrect(std::span{expected}.first(tiled_bytes), input, bpp, width, height, depth,
+                   0, 0, width, height * depth, block_height, block_depth, width * bpp, native);
+    SwizzleTexture(std::span{tiled}.first(tiled_bytes), input, bpp, width, height, depth,
+                   block_height, block_depth, 0, native);
+    REQUIRE(tiled == expected);
+    std::vector<u8> result(linear_bytes + 64, 0xa5);
+    UnswizzleTexture(std::span{result}.first(linear_bytes), expected, bpp, width, height, depth,
+                     block_height, block_depth, 0, native);
+    REQUIRE(std::equal(input.begin(), input.end(), result.begin()));
+    REQUIRE(std::ranges::all_of(std::span{result}.last(64), [](u8 value) { return value == 0xa5; }));
+}
diff --git a/src/tests/video_core/nx2_command_sync.cpp b/src/tests/video_core/nx2_command_sync.cpp
new file mode 100644
index 00000000..63a880c1
--- /dev/null
+++ b/src/tests/video_core/nx2_command_sync.cpp
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/nx2.h"
+
+namespace {
+constexpr u64 Page = u64{1} << Tegra::Nx2WrittenPageBits;
+constexpr u64 AddressSpace = u64{1} << 36;
+} // Anonymous namespace
+
+TEST_CASE("GPU-written command pages are tracked per page over the whole range",
+          "[video_core][nx2_command_sync]") {
+    Tegra::Nx2ClearGpuWrittenPages();
+    Tegra::Nx2MarkGpuWritten(16 * Page + Page - 8, 16);
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(15 * Page + Page - 1));
+    REQUIRE(Tegra::Nx2IsGpuWritten(16 * Page));
+    REQUIRE(Tegra::Nx2IsGpuWritten(16 * Page + Page - 1));
+    REQUIRE(Tegra::Nx2IsGpuWritten(17 * Page));
+    REQUIRE(Tegra::Nx2IsGpuWritten(17 * Page + 7));
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(18 * Page));
+}
+
+TEST_CASE("Empty and out of range writes mark nothing past the device address space",
+          "[video_core][nx2_command_sync]") {
+    Tegra::Nx2ClearGpuWrittenPages();
+    Tegra::Nx2MarkGpuWritten(4 * Page, 0);
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(4 * Page));
+
+    Tegra::Nx2MarkGpuWritten(AddressSpace - 4, 8);
+    REQUIRE(Tegra::Nx2IsGpuWritten(AddressSpace - 1));
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(AddressSpace));
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(AddressSpace + Page));
+}
+
+TEST_CASE("A new session forgets the pages the previous one wrote",
+          "[video_core][nx2_command_sync]") {
+    Tegra::Nx2ClearGpuWrittenPages();
+    Tegra::Nx2MarkGpuWritten(64 * Page, 3 * Page);
+    REQUIRE(Tegra::Nx2IsGpuWritten(66 * Page));
+    Tegra::Nx2ClearGpuWrittenPages();
+    for (u64 page = 63; page <= 67; ++page) {
+        REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(page * Page));
+    }
+}
+
+TEST_CASE("Command list pages are tracked apart from written pages and cleared per session",
+          "[video_core][nx2_command_sync]") {
+    Tegra::Nx2ClearGpuWrittenPages();
+    REQUIRE_FALSE(Tegra::g_nx2_has_command_list_pages.load());
+    Tegra::Nx2MarkCommandListPage(8 * Page + 12);
+    REQUIRE(Tegra::Nx2IsCommandListPage(8 * Page));
+    REQUIRE_FALSE(Tegra::Nx2IsCommandListPage(9 * Page));
+    REQUIRE_FALSE(Tegra::Nx2IsGpuWritten(8 * Page));
+    REQUIRE(Tegra::g_nx2_has_command_list_pages.load());
+    Tegra::Nx2MarkCommandListPage(AddressSpace);
+    REQUIRE_FALSE(Tegra::Nx2IsCommandListPage(AddressSpace));
+    Tegra::Nx2ClearGpuWrittenPages();
+    REQUIRE_FALSE(Tegra::Nx2IsCommandListPage(8 * Page));
+    REQUIRE_FALSE(Tegra::g_nx2_has_command_list_pages.load());
+}
diff --git a/src/tests/video_core/nx2_layer_upload.cpp b/src/tests/video_core/nx2_layer_upload.cpp
new file mode 100644
index 00000000..3300c5d0
--- /dev/null
+++ b/src/tests/video_core/nx2_layer_upload.cpp
@@ -0,0 +1,222 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <limits>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+#include "video_core/texture_cache/image_info.h"
+#include "video_core/texture_cache/util.h"
+
+namespace {
+using namespace VideoCommon;
+using VideoCore::Surface::PixelFormat;
+
+void CheckStream(ImageInfo info, bool native, size_t limit, std::span<const u32> selected,
+                 bool fragmented = false) {
+    info.layer_stride = CalculateLayerStride(info);
+    ImageInfo reference_info = info;
+    reference_info.resources.layers = static_cast<s32>(*std::ranges::max_element(selected) + 1);
+    const size_t guest_size = size_t{info.layer_stride} * reference_info.resources.layers;
+    std::vector<u8> guest(guest_size);
+    u32 random = 0x91e10da5;
+    for (auto& byte : guest) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        byte = static_cast<u8>(random);
+    }
+    // Model GPU pages mapped to reversed device pages, including unmapped holes and
+    // two GPU pages naming the same backing. The reference sees the resulting logical bytes.
+    constexpr size_t page_size = 64 * 1024;
+    const size_t pages = (guest.size() + page_size - 1) / page_size;
+    std::vector<u8> backing;
+    std::vector<size_t> page_map;
+    if (fragmented) {
+        backing.resize(pages * page_size);
+        page_map.resize(pages);
+        for (size_t page = 0; page < pages; ++page) {
+            const size_t bytes = std::min(page_size, guest.size() - page * page_size);
+            page_map[page] = pages - 1 - page;
+            std::memcpy(backing.data() + page_map[page] * page_size,
+                        guest.data() + page * page_size, bytes);
+        }
+        for (size_t page = 0; page < pages; ++page) {
+            const size_t bytes = std::min(page_size, guest.size() - page * page_size);
+            if (page % 7 == 3) {
+                page_map[page] = pages;
+                std::fill_n(guest.data() + page * page_size, bytes, 0);
+            } else if (page % 11 == 5) {
+                page_map[page] = page_map[0];
+                std::memcpy(guest.data() + page * page_size,
+                            backing.data() + page_map[0] * page_size, bytes);
+            }
+        }
+    }
+    std::vector<u8> expected(CalculateUnswizzledSizeBytes(reference_info));
+    const auto reference = UnswizzleBlockLinearImage(reference_info, guest, expected, native);
+    REQUIRE(reference.size() == static_cast<size_t>(info.resources.levels));
+    for (const auto& copy : reference) {
+        const size_t layer_bytes = copy.buffer_size / reference_info.resources.layers;
+        for (s32 layer = 0; layer < reference_info.resources.layers; ++layer) {
+            if (std::ranges::find(selected, layer) == selected.end()) {
+                std::fill_n(expected.begin() + copy.buffer_offset + layer * layer_bytes,
+                            layer_bytes, 0xd3);
+            }
+        }
+    }
+    std::vector<u8> actual(expected.size(), 0xd3);
+    constexpr GPUVAddr base = 0x500000000ULL;
+    size_t chunks{}, peak{};
+    const u32 bpp = VideoCore::Surface::BytesPerBlock(info.format);
+    const u32 bw = VideoCore::Surface::DefaultBlockWidth(info.format);
+    const u32 bh = VideoCore::Surface::DefaultBlockHeight(info.format);
+    REQUIRE(StreamLayerUploads(info, base, selected, limit,
+        [&](GPUVAddr address, std::span<u8> bytes) {
+            REQUIRE(address >= base);
+            REQUIRE(address - base + bytes.size() <= guest.size());
+            CHECK(bytes.size() <= limit);
+            if (!fragmented) {
+                std::memcpy(bytes.data(), guest.data() + address - base, bytes.size());
+                return;
+            }
+            size_t offset = static_cast<size_t>(address - base);
+            while (!bytes.empty()) {
+                const size_t page = offset / page_size;
+                const size_t in_page = offset % page_size;
+                const size_t count = std::min(bytes.size(), page_size - in_page);
+                if (page_map[page] == pages) std::fill_n(bytes.data(), count, 0);
+                else std::memcpy(bytes.data(), backing.data() + page_map[page] * page_size +
+                                 in_page, count);
+                offset += count;
+                bytes = bytes.subspan(count);
+            }
+        },
+        [&](std::span<const u8> bytes, std::span<const BufferImageCopy> copies) {
+            ++chunks;
+            peak = std::max(peak, bytes.size());
+            REQUIRE(bytes.size() <= limit);
+            for (const auto& copy : copies) {
+                const auto& ref = reference.at(copy.image_subresource.base_level);
+                const auto layer = copy.image_subresource.base_layer;
+                REQUIRE(std::ranges::find(selected, layer) != selected.end());
+                REQUIRE(copy.image_subresource.num_layers == 1);
+                REQUIRE(copy.image_offset.x >= 0);
+                REQUIRE(copy.image_offset.y >= 0);
+                REQUIRE(copy.image_offset.x % bw == 0);
+                REQUIRE(copy.image_offset.y % bh == 0);
+                REQUIRE(copy.image_offset.x + copy.image_extent.width <= ref.image_extent.width);
+                REQUIRE(copy.image_offset.y + copy.image_extent.height <= ref.image_extent.height);
+                const size_t row_bytes = ((copy.image_extent.width + bw - 1) / bw) * bpp;
+                const size_t stride = ((copy.buffer_row_length + bw - 1) / bw) * bpp;
+                const size_t ref_stride = ((ref.buffer_row_length + bw - 1) / bw) * bpp;
+                const size_t rows = (copy.image_extent.height + bh - 1) / bh;
+                const size_t dst = ref.buffer_offset + layer * (ref.buffer_size / reference_info.resources.layers) +
+                                   (copy.image_offset.y / bh) * ref_stride + (copy.image_offset.x / bw) * bpp;
+                for (size_t y = 0; y < rows; ++y) {
+                    const size_t src = copy.buffer_offset + y * stride;
+                    REQUIRE(src + row_bytes <= bytes.size());
+                    REQUIRE(dst + y * ref_stride + row_bytes <= actual.size());
+                    std::memcpy(actual.data() + dst + y * ref_stride, bytes.data() + src, row_bytes);
+                }
+            }
+        }, native));
+    CHECK(chunks > 0);
+    CHECK(peak <= limit);
+    CHECK(actual == expected);
+}
+}
+
+TEST_CASE("Layer streaming preserves mip pixels, selected layer order and tiling",
+          "[nx2_layer_upload]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {777, 193, 1};
+    info.format = GENERATE(PixelFormat::R8_UNORM, PixelFormat::A8B8G8R8_UNORM,
+                           PixelFormat::R32G32_FLOAT, PixelFormat::BC1_RGBA_UNORM,
+                           PixelFormat::BC3_UNORM);
+    info.block.height = GENERATE(0U, 2U, 4U);
+    info.tile_width_spacing = GENERATE(0U, 1U, 2U, 3U, 4U);
+    info.resources = {5, 3};
+    const bool native = GENERATE(false, true);
+    CAPTURE(info.format, info.block.height, info.tile_width_spacing, native);
+    CheckStream(info, native, 512 * 1024, std::array<u32, 2>{2, 0});
+}
+
+TEST_CASE("The 358 MB Mario Kart layer uses bounded upload chunks", "[nx2_layer_upload]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {8192, 8192, 1};
+    info.format = PixelFormat::A8B8G8R8_UNORM;
+    info.block.height = 4;
+    info.tile_width_spacing = 2;
+    info.resources = {12, 1};
+    CHECK(CalculateUnswizzledSizeBytes(info) == 357913920);
+    CheckStream(info, true, 8 * 1024 * 1024, std::array<u32, 1>{0});
+}
+
+TEST_CASE("Mario Kart's spacing-four BC3 terrain layers stream without the 358 MB map",
+          "[nx2_layer_upload]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {8192, 8192, 1};
+    info.format = PixelFormat::BC3_UNORM;
+    info.block.height = 3;
+    info.tile_width_spacing = 4;
+    info.resources = {12, 68};
+    auto layer = info;
+    layer.resources.layers = 1;
+    CHECK(CalculateUnswizzledSizeBytes(layer) * 4 == 357913920);
+    CheckStream(info, true, 8 * 1024 * 1024, std::array<u32, 4>{0, 1, 2, 3});
+}
+
+TEST_CASE("Unsupported layer streams have no reads or partial uploads", "[nx2_layer_upload]") {
+    ImageInfo good;
+    good.type = ImageType::e2D;
+    good.format = PixelFormat::R8_UNORM;
+    good.size = {256, 256, 1};
+    good.resources = {1, 1};
+    size_t calls{};
+    auto read = [&](GPUVAddr, std::span<u8>) { ++calls; };
+    auto upload = [&](std::span<const u8>, std::span<const BufferImageCopy>) { ++calls; };
+    const std::array<u32, 1> layers{0};
+    for (unsigned test = 0; test < 10; ++test) {
+        auto info = good;
+        size_t limit = 1024 * 1024;
+        switch (test) {
+        case 0: info.type = ImageType::e3D; break;
+        case 1: info.size.depth = 2; break;
+        case 2: info.block.depth = 1; break;
+        case 3: info.num_samples = 4; break;
+        case 4: info.resources.levels = 0; break;
+        case 5: info.resources.levels = MAX_MIP_LEVELS + 1; break;
+        case 6: info.block.height = 6; break;
+        case 7: limit = 511; break;
+        case 8: info.layer_stride = 1; break;
+        case 9: info.block.width = 1; break;
+        }
+        CAPTURE(test);
+        CHECK_FALSE(StreamLayerUploads(info, 0x500000000ULL, layers, limit, read, upload, true));
+        CHECK(calls == 0);
+    }
+    CHECK_FALSE(StreamLayerUploads(good, (std::numeric_limits<u64>::max)() - 10,
+                                   layers, 1024 * 1024, read, upload, true));
+    CHECK_FALSE(StreamLayerUploads(good, 0x500000000ULL, std::array<u32, 1>{1},
+                                   1024 * 1024, read, upload, true));
+    CHECK(calls == 0);
+}
+
+TEST_CASE("Layer chunks preserve pixels with scattered device pages, holes and aliases",
+          "[nx2_layer_upload]") {
+    ImageInfo info;
+    info.type = ImageType::e2D;
+    info.size = {1536, 777, 1};
+    info.format = GENERATE(PixelFormat::A8B8G8R8_UNORM, PixelFormat::BC3_UNORM);
+    info.block.height = 4;
+    info.tile_width_spacing = 1;
+    info.resources = {4, 2};
+    CheckStream(info, true, 512 * 1024, std::array<u32, 2>{1, 0}, true);
+}
diff --git a/src/tests/video_core/nx2_sparse_image_layout.cpp b/src/tests/video_core/nx2_sparse_image_layout.cpp
new file mode 100644
index 00000000..ce91ccf4
--- /dev/null
+++ b/src/tests/video_core/nx2_sparse_image_layout.cpp
@@ -0,0 +1,310 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+
+#include "video_core/texture_cache/image_info.h"
+#include "video_core/texture_cache/util.h"
+#include "video_core/textures/decoders.h"
+
+namespace {
+
+VideoCommon::ImageInfo MakeImage(u32 width, u32 height) {
+    VideoCommon::ImageInfo info;
+    info.type = VideoCommon::ImageType::e2D;
+    info.format = VideoCore::Surface::PixelFormat::R8_UNORM;
+    info.size = {width, height, 1};
+    info.resources = {1, 1};
+    return info;
+}
+
+} // namespace
+
+TEST_CASE("Sparse texture byte ranges select host tiles from guest GOB columns",
+          "[nx2_sparse_image]") {
+    const auto info = MakeImage(256, 128);
+    const std::array<std::pair<u64, u64>, 2> ranges{{{0, 1}, {1024, 1}}};
+    CHECK(VideoCommon::SparseTileRects(info, ranges, 128, 64, 1) ==
+          std::vector<VideoCommon::LevelRect>{{0, 0, 0, 256, 64}});
+    const std::array<std::pair<u64, u64>, 1> lower{{{16384, 1}}};
+    const auto rects = VideoCommon::SparseTileRects(info, lower, 128, 64, 1);
+    CHECK(rects == std::vector<VideoCommon::LevelRect>{{0, 0, 64, 128, 64}});
+    CHECK(VideoCommon::UnswizzledRectsBytes(info, rects) == 128 * 64);
+    CHECK(VideoCommon::SparseTileRects(info, {}, 128, 64, 1).empty());
+}
+
+TEST_CASE("Sparse texture edge tiles clip to the image width", "[nx2_sparse_image]") {
+    const auto info = MakeImage(130, 65);
+    const std::array<std::pair<u64, u64>, 1> edge{{{1024, 1}}};
+    const auto rects = VideoCommon::SparseTileRects(info, edge, 128, 64, 1);
+    CHECK(rects == std::vector<VideoCommon::LevelRect>{{0, 128, 0, 2, 64}});
+    CHECK(VideoCommon::UnswizzledRectsBytes(info, rects) == 64 * 64);
+    const std::array<std::pair<u64, u64>, 1> next_row{{{1536, 512}}};
+    CHECK(VideoCommon::SparseTileRects(info, next_row, 128, 64, 1) ==
+          std::vector<VideoCommon::LevelRect>{{0, 0, 0, 128, 64}});
+}
+
+TEST_CASE("Sparse mip tails upload whole levels only when touched", "[nx2_sparse_image]") {
+    auto info = MakeImage(256, 128);
+    info.resources.levels = 3;
+    const auto offsets = VideoCommon::CalculateMipLevelOffsets(info);
+    const std::array<std::pair<u64, u64>, 1> tail{{{offsets[2] + 1, 1}}};
+    CHECK(VideoCommon::SparseTileRects(info, tail, 128, 64, 1) ==
+          std::vector<VideoCommon::LevelRect>{{2, 0, 0, 64, 32}});
+    const std::array<std::pair<u64, u64>, 1> boundary{{{offsets[1] - 1, 2}}};
+    const auto rects = VideoCommon::SparseTileRects(info, boundary, 128, 64, 1);
+    REQUIRE(rects.size() == 2);
+    CHECK(rects.back() == VideoCommon::LevelRect{1, 0, 0, 128, 64});
+}
+
+TEST_CASE("Sparse rectangle uploads match the whole-image unswizzle bytes and regions",
+          "[nx2_sparse_image][nx2_sparse_unswizzle]") {
+    using VideoCore::Surface::PixelFormat;
+    const auto format = GENERATE(PixelFormat::R8_UNORM, PixelFormat::R16_UNORM,
+                                 PixelFormat::A8B8G8R8_UNORM, PixelFormat::R32G32_FLOAT,
+                                 PixelFormat::R32G32B32A32_FLOAT);
+    const auto block_height = GENERATE(0U, 2U, 4U);
+    const auto spacing = GENERATE(0U, 1U, 2U, 3U);
+    const bool native_tiling = GENERATE(false, true);
+    CAPTURE(format, block_height, spacing, native_tiling);
+    auto info = MakeImage(258, 137);
+    info.format = format;
+    info.block.height = block_height;
+    info.tile_width_spacing = spacing;
+    info.resources.levels = 5;
+    const u32 bytes_per_pixel = VideoCore::Surface::BytesPerBlock(format);
+    std::vector<u8> guest(VideoCommon::CalculateGuestSizeInBytes(info));
+    u32 random = 0x91e10da5;
+    for (auto& byte : guest) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        byte = static_cast<u8>(random);
+    }
+    std::vector<u8> whole(VideoCommon::CalculateUnswizzledSizeBytes(info));
+    const auto whole_copies =
+        VideoCommon::UnswizzleBlockLinearImage(info, guest, whole, native_tiling);
+    REQUIRE(whole_copies.size() == 5);
+    std::vector<VideoCommon::LevelRect> rects{{0, 128, 64, 128, 64}, {0, 256, 128, 2, 9}};
+    for (s32 level = 1; level < info.resources.levels; ++level) {
+        const auto& extent = whole_copies[level].image_extent;
+        rects.push_back({level, 0, 0, extent.width, extent.height});
+    }
+
+    const auto output_size = VideoCommon::UnswizzledRectsBytes(info, rects);
+    constexpr size_t guard_size = 32;
+    std::vector<u8> guarded_output(output_size + 2 * guard_size, 0xa5);
+    const auto output = std::span{guarded_output}.subspan(guard_size, output_size);
+    constexpr GPUVAddr guest_base = 0x123450000;
+    size_t reads = 0;
+    const auto copies = VideoCommon::UnswizzleImageRects(
+        [&](GPUVAddr address, std::span<u8> bytes) {
+            REQUIRE(address >= guest_base);
+            const auto offset = address - guest_base;
+            REQUIRE(offset <= guest.size());
+            REQUIRE(bytes.size() <= guest.size() - offset);
+            std::memcpy(bytes.data(), guest.data() + offset, bytes.size());
+            ++reads;
+        },
+        guest_base, info, rects, output, native_tiling);
+    REQUIRE_FALSE(copies.empty());
+    CHECK(reads == copies.size());
+    CHECK(std::ranges::all_of(std::span{guarded_output}.first(guard_size),
+                              [](u8 byte) { return byte == 0xa5; }));
+    CHECK(std::ranges::all_of(std::span{guarded_output}.last(guard_size),
+                              [](u8 byte) { return byte == 0xa5; }));
+
+    std::vector<u8> actual(whole.size(), 0xcd);
+    std::vector<u8> expected(whole.size(), 0xcd);
+    std::vector<u8> actual_coverage(whole.size());
+    std::vector<u8> expected_coverage(whole.size());
+    for (const auto& rect : rects) {
+        const auto& whole_copy = whole_copies[rect.level];
+        for (u32 y = rect.y; y < rect.y + rect.height; ++y) {
+            const size_t offset = whole_copy.buffer_offset +
+                                  (size_t{y} * whole_copy.buffer_row_length + rect.x) *
+                                      bytes_per_pixel;
+            const size_t bytes = size_t{rect.width} * bytes_per_pixel;
+            std::copy_n(whole.begin() + offset, bytes, expected.begin() + offset);
+            std::fill_n(expected_coverage.begin() + offset, bytes, 1);
+        }
+    }
+    size_t consumed_bytes = 0;
+    for (const auto& copy : copies) {
+        const auto level = copy.image_subresource.base_level;
+        REQUIRE(level >= 0);
+        REQUIRE(level < info.resources.levels);
+        const auto& whole_copy = whole_copies[level];
+        CHECK(copy.image_subresource.base_layer == 0);
+        CHECK(copy.image_subresource.num_layers == 1);
+        CHECK(copy.image_offset.z == 0);
+        CHECK(copy.image_extent.depth == 1);
+        REQUIRE(copy.image_offset.x >= 0);
+        REQUIRE(copy.image_offset.y >= 0);
+        REQUIRE(copy.image_offset.x + copy.image_extent.width <= whole_copy.image_extent.width);
+        REQUIRE(copy.image_offset.y + copy.image_extent.height <= whole_copy.image_extent.height);
+        REQUIRE(copy.buffer_row_length >= copy.image_extent.width);
+        REQUIRE(copy.buffer_image_height >= copy.image_extent.height);
+        CHECK(copy.buffer_size == size_t{copy.buffer_row_length} * copy.buffer_image_height *
+                                      bytes_per_pixel);
+        REQUIRE(copy.buffer_offset >= consumed_bytes);
+        REQUIRE(copy.buffer_offset < consumed_bytes + copy.buffer_size);
+        consumed_bytes += copy.buffer_size;
+        for (u32 row = 0; row < copy.image_extent.height; ++row) {
+            const size_t source = copy.buffer_offset +
+                                  size_t{row} * copy.buffer_row_length * bytes_per_pixel;
+            const size_t destination =
+                whole_copy.buffer_offset +
+                (size_t{copy.image_offset.y + row} * whole_copy.buffer_row_length +
+                 copy.image_offset.x) * bytes_per_pixel;
+            const size_t bytes = size_t{copy.image_extent.width} * bytes_per_pixel;
+            REQUIRE(source + bytes <= output.size());
+            REQUIRE(destination + bytes <= actual.size());
+            CHECK(std::equal(output.begin() + source, output.begin() + source + bytes,
+                             whole.begin() + destination));
+            std::copy_n(output.begin() + source, bytes, actual.begin() + destination);
+            for (size_t byte = destination; byte < destination + bytes; ++byte) {
+                ++actual_coverage[byte];
+            }
+        }
+    }
+    CHECK(consumed_bytes == output_size);
+    CHECK(actual_coverage == expected_coverage);
+    CHECK(actual == expected);
+
+    std::fill(actual.begin(), actual.end(), 0xcd);
+    std::fill(actual_coverage.begin(), actual_coverage.end(), 0);
+    constexpr size_t chunk_limit = 32768;
+    size_t chunks{};
+    REQUIRE(VideoCommon::StreamRectUploads(info, guest_base, rects, chunk_limit,
+        [&](GPUVAddr address, std::span<u8> bytes) {
+            REQUIRE(address >= guest_base);
+            REQUIRE(address - guest_base + bytes.size() <= guest.size());
+            REQUIRE(bytes.size() <= chunk_limit);
+            std::memcpy(bytes.data(), guest.data() + address - guest_base, bytes.size());
+        },
+        [&](std::span<const u8> bytes, std::span<const VideoCommon::BufferImageCopy> uploads) {
+            ++chunks;
+            REQUIRE(bytes.size() <= chunk_limit);
+            for (const auto& copy : uploads) {
+                const auto& ref = whole_copies.at(copy.image_subresource.base_level);
+                REQUIRE(copy.image_subresource.base_layer == 0);
+                REQUIRE(copy.image_subresource.num_layers == 1);
+                for (u32 y = 0; y < copy.image_extent.height; ++y) {
+                    const size_t source = copy.buffer_offset + size_t{y} *
+                                          copy.buffer_row_length * bytes_per_pixel;
+                    const size_t destination = ref.buffer_offset +
+                        (size_t{copy.image_offset.y + y} * ref.buffer_row_length +
+                         copy.image_offset.x) * bytes_per_pixel;
+                    const size_t row_bytes = size_t{copy.image_extent.width} * bytes_per_pixel;
+                    REQUIRE(source + row_bytes <= bytes.size());
+                    REQUIRE(destination + row_bytes <= actual.size());
+                    std::copy_n(bytes.begin() + source, row_bytes, actual.begin() + destination);
+                    for (size_t byte = destination; byte < destination + row_bytes; ++byte)
+                        ++actual_coverage[byte];
+                }
+            }
+        }, native_tiling));
+    CHECK(chunks > 0);
+    CHECK(actual_coverage == expected_coverage);
+    CHECK(actual == expected);
+}
+
+TEST_CASE("Spaced sparse tile selection covers every texel from written guest ranges",
+          "[nx2_sparse_image][nx2_sparse_unswizzle]") {
+    using VideoCore::Surface::PixelFormat;
+    const auto spacing = GENERATE(1U, 2U, 3U);
+    const auto format = GENERATE(PixelFormat::R8_UNORM, PixelFormat::R16_UNORM);
+    const bool native = GENERATE(false, true);
+    auto info = MakeImage(777, 193);
+    info.format = format;
+    info.block.height = 2;
+    info.tile_width_spacing = spacing;
+    info.resources.levels = 4;
+    const size_t guest_size = VideoCommon::CalculateGuestSizeInBytes(info);
+    for (const auto first : {size_t{0},size_t{512},size_t{8192},guest_size/2,guest_size-512}) {
+        CAPTURE(spacing,format,native,first);
+        const size_t bytes = std::min(size_t{512},guest_size-first);
+        std::vector<u8> guest(guest_size);
+        std::fill_n(guest.begin()+first,bytes,0xff);
+        std::vector<u8> whole(VideoCommon::CalculateUnswizzledSizeBytes(info));
+        const auto copies = VideoCommon::UnswizzleBlockLinearImage(info,guest,whole,native);
+        const std::array<std::pair<u64,u64>,1> ranges{{{first,bytes}}};
+        const auto rects=VideoCommon::SparseTileRects(info,ranges,128,64,3);
+        const u32 bpp=VideoCore::Surface::BytesPerBlock(format);
+        for(size_t level=0;level<copies.size();++level) {
+            const auto& c=copies[level];
+            for(u32 y=0;y<c.image_extent.height;++y)for(u32 x=0;x<c.image_extent.width;++x) {
+                const size_t offset=c.buffer_offset+(size_t{y}*c.buffer_row_length+x)*bpp;
+                if(!std::ranges::any_of(std::span{whole}.subspan(offset,bpp),[](u8 v){return v!=0;}))continue;
+                REQUIRE(std::ranges::any_of(rects,[&](const auto& r){
+                    return r.level==level && x>=r.x && x<r.x+r.width && y>=r.y && y<r.y+r.height;
+                }));
+            }
+        }
+    }
+}
+
+TEST_CASE("Banded readback preserves pixels and padded guest bytes", "[nx2_sparse_image]") {
+    const auto spacing=GENERATE(0U,1U,2U,3U);
+    const auto block_height=GENERATE(0U,2U,4U);
+    const auto format=GENERATE(VideoCore::Surface::PixelFormat::R8_UNORM,
+                              VideoCore::Surface::PixelFormat::A8B8G8R8_UNORM);
+    const bool native=GENERATE(false,true);
+    auto info=MakeImage(777,193);info.format=format;info.tile_width_spacing=spacing;
+    info.block.height=block_height;
+    std::vector<u8> initial(VideoCommon::CalculateGuestSizeInBytes(info));
+    for(size_t i=0;i<initial.size();++i)initial[i]=u8(i*39+11);
+    std::vector<u8> linear(VideoCommon::CalculateUnswizzledSizeBytes(info));
+    for(size_t i=0;i<linear.size();++i)linear[i]=u8(i*73+19);
+    auto expected=initial;
+    const u32 bpp=VideoCore::Surface::BytesPerBlock(format);
+    // Whole-image baseline through the same decoder's full-layout writer.
+    const u32 alignment=VideoCommon::CalculateLevelStrideAlignment(info,0);
+    Tegra::Texture::SwizzleTexture(expected,linear,bpp,info.size.width,info.size.height,1,
+                                   block_height,0,alignment,native);
+    auto actual=initial;
+    const auto bands=VideoCommon::DownloadRowBands(info,512*1024);
+    REQUIRE_FALSE(bands.empty());
+    size_t seen=0;
+    for(const auto& copy:bands){
+        CHECK(copy.buffer_size<=512*1024);
+        const auto [offset,bytes]=VideoCommon::RowBandGuestRange(info,copy);
+        REQUIRE(offset+bytes<=actual.size());
+        const size_t host=size_t(copy.image_offset.y)*info.size.width*bpp;
+        VideoCommon::SwizzleRowBand(info,copy,std::span{linear}.subspan(host,copy.buffer_size),
+                                    std::span{actual}.subspan(offset,bytes),native);
+        seen+=copy.image_extent.height;
+    }
+    CHECK(seen==info.size.height);
+    CHECK(actual==expected);
+}
+
+TEST_CASE("Sparse upload preflight rejects invalid rectangles without partial callbacks",
+          "[nx2_sparse_image][nx2_sparse_unswizzle]") {
+    auto info = MakeImage(256, 256);
+    info.block.height = 2;
+    size_t callbacks{};
+    const auto read = [&](GPUVAddr, std::span<u8>) { ++callbacks; };
+    const auto upload = [&](std::span<const u8>, std::span<const VideoCommon::BufferImageCopy>) {
+        ++callbacks;
+    };
+    for (const auto rect : std::array<VideoCommon::LevelRect, 6>{
+             {{1,0,0,16,16}, {0,0,0,0,16}, {0,0,0,257,16},
+              {0,0,250,64,16}, {0,1,0,64,16}, {-1,0,0,64,16}}}) {
+        const std::array rects{VideoCommon::LevelRect{0,0,0,64,16}, rect};
+        CHECK_FALSE(VideoCommon::StreamRectUploads(info, 0x500000000, rects, 32768,
+                                                   read, upload, true));
+        CHECK(callbacks == 0);
+    }
+    const std::array rects{VideoCommon::LevelRect{0,0,0,64,16}};
+    CHECK_FALSE(VideoCommon::StreamRectUploads(info, 0x500000000, rects, 1, read, upload, true));
+    CHECK_FALSE(VideoCommon::StreamRectUploads(info, ~GPUVAddr{}, rects, 32768,
+                                               read, upload, true));
+    CHECK(callbacks == 0);
+}
